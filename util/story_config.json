        { "label": "Fire Nation", "set_home": "fire_nation", "next": "scene_monk_conversation" },
        { "label": "Water Tribe Village", "set_home": "water_tribe", "next": "scene_monk_conversation" },
        { "label": "Earth Kingdom", "set_home": "earth_kingdom", "next": "scene_monk_conversation" },
        { "label": "Air Temple", "set_home": "air_temple", "next": "scene_monk_conversation" }
      ]
    },

    "scene_monk_conversation": {
      "type": "dialogue",
      "text": "A worried monk says: 'The Avatar cycle has been disrupted. The four nations are falling out of balance. Travel, train, and defeat the disturbances before darkness reaches the spirit realm.'",
      "set_flag": "has_heard_monk_warning",
      "next": "scene_region_select"
    },

    "scene_region_select": {
      "type": "region_select",
      "text": "Choose which region to investigate next.",
      "note": "Filter out resolved regions and optionally the home region on first visit."
    },

    "scene_check_conflicts": {
      "type": "condition",
      "condition": "resolved_regions.length == 4",
      "true_next": "scene_spirit_realm_gate",
      "false_next": "scene_region_select"
    },

    "scene_die_restart": {
      "type": "death",
      "text": "You were defeated. Restarting from the beginning.",
      "next": "scene_prologue_choose_world"
    },

    "scene_spirit_realm_gate": {
      "type": "dialogue",
      "text": "The air goes silent. An invisible voice whispers: 'Balance is weakness. Power comes from dominance.'",
      "set_flag": "has_heard_invisible_voice",
      "next": "scene_enter_spirit_realm_prompt"
    },

    "scene_enter_spirit_realm_prompt": {
      "type": "prompt",
      "text": "A gate opens to the spirit realm. Will you enter and face the corrupted bender?",
      "options": [
        { "label": "Enter the spirit realm", "next": "scene_final_battle" },
        { "label": "Prepare more first", "next": "scene_region_select" }
      ]
    },

    "scene_final_battle": {
      "type": "final_battle",
      "text": "Inside the spirit realm, the corrupted bender waits. This is the source of the broken Avatar cycle.",
      "enemy": "boss_corrupted_avatar_cycle",
      "on_win": "scene_good_ending",
      "on_lose": "scene_bad_ending"
    },

    "scene_good_ending": {
      "type": "ending",
      "result": "good",
      "text": "The hero defeats the corrupted bender. The Avatar cycle begins to heal. Balance is restored."
    },

    "scene_bad_ending": {
      "type": "ending",
      "result": "bad",
      "text": "The hero falls. Terror spreads to the villages. The Avatar cycle is lost.",
      "next": "scene_prologue_choose_world"
    },

