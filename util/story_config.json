    "scene_prologue_choose_world": {
      "type": "world_select",
      "text": "Your journey begins. Choose your home world.",
      "options": [
        { "label": "Fire Nation",        "set_home": "fire_nation",   "next": "scene_monk_conversation" },
        { "label": "Water Tribe Village","set_home": "water_tribe",   "next": "scene_monk_conversation" },
