  "story_flow": [
    {
      "act": "prologue",
      "sequence": 1,
      "id": "choose_home_world",
      "scene_id": "scene_prologue_choose_world",
      "summary": "Player chooses a home world: Fire Nation, Water Tribe Village, Earth Kingdom, or Air Temple.",
      "next_scene_id": "scene_monk_conversation"
    },
    {
      "act": "prologue",
      "sequence": 2,
      "id": "monk_conversation",
      "scene_id": "scene_monk_conversation",
      "summary": "A monk warns that the Avatar cycle has been disrupted.",
      "sets_flags": {
        "has_heard_monk_warning": true
      },
      "next_scene_id": "scene_act1_region_select"
    },
    {
      "act": "act_i",
      "sequence": 3,
      "id": "select_disturbed_region",
      "scene_id": "scene_act1_region_select",
      "summary": "Hero chooses a region with a disturbance. If the story rule is enabled, the home region is not available as the first disturbance.",
      "next_scene_id_template": "scene_{region_id}_hub"
    },
    {
      "act": "act_i",
      "sequence": 4,
      "id": "regional_preparation",
      "summary": "Hero may train elements, train stats, buy items at the store, or rest at the inn before the dungeon.",
      "available_location_types": [
        "training_location",
        "store",
        "inn",
        "dungeon"
      ]
    },
    {
      "act": "act_i",
      "sequence": 5,
      "id": "regional_dungeon",
      "summary": "Hero enters the chosen region dungeon. Dungeon is linear with four rooms: entrance, battle room, camp room, boss fight.",
      "on_win": "scene_region_win_dialogue",
      "on_lose": "scene_die_restart"
    },
    {
      "act": "act_ii_loop",
      "sequence": 6,
      "id": "check_all_conflicts",
      "summary": "If all four regional conflicts are solved, enter final act. Otherwise, return to region select and continue.",
      "condition": "resolved_regions.length == 4",
      "true_next_scene_id": "scene_final_act_spirit_realm_gate",
      "false_next_scene_id": "scene_act1_region_select"
    },
    {
      "act": "final_act",
      "sequence": 7,
      "id": "invisible_voice",
      "scene_id": "scene_final_act_spirit_realm_gate",
      "summary": "After all disturbances are defeated, an invisible voice whispers that balance is weakness and power comes from dominance.",
      "sets_flags": {
        "has_heard_invisible_voice": true
      },
      "next_scene_id": "scene_final_prompt_enter_spirit_realm"
    },
    {
      "act": "final_act",
      "sequence": 8,
      "id": "enter_spirit_realm",
      "scene_id": "scene_final_prompt_enter_spirit_realm",
      "summary": "Player answers the prompt and enters the spirit realm to fight the corrupted bender.",
      "next_scene_id": "scene_final_battle"
    },
    {
      "act": "final_act",
      "sequence": 9,
      "id": "final_battle",
      "scene_id": "scene_final_battle",
      "summary": "Hero fights the corrupted bender in the spirit realm.",
      "on_win": "scene_good_ending",
      "on_lose": "scene_bad_ending"
    }
  ],
